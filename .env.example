# MineIntel Production Environment Variables
# -------------------------------------------
# Copy this file to .env for local development.
# For Vercel production deployment, set each variable in the Vercel dashboard under
# Project -> Settings -> Environment Variables.
#
# NEVER commit .env to git (it is already in .gitignore)

# --- REQUIRED: Master Authentication ---
# Master officer ID used to log in and to authorize creating new users.
MINEINTEL_OFFICER_ID=MOC-TEST-OFFICER-7890

# Master password for the officer above.
MINEINTEL_AUTH_PASSWORD=Enclave@Auth#2026

# --- REQUIRED: JWT Signing Secret ---
# Long random string used to sign/verify session tokens.
# Generate: python -c import secrets; print(secrets.token_hex(32))
MINEINTEL_JWT_SECRET=your-long-random-jwt-secret

# --- REQUIRED: PostgreSQL (Neon DB for Agent State) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- REQUIRED: Security & CORS ---
# In production, set to your EXACT frontend domain (e.g., https://your-vercel-domain.com).
# DO NOT leave as '*' in production.
CORS_ORIGINS=*

# --- REQUIRED: AI Provider (Local Ollama) ---
MINEINTEL_AI_PROVIDER=local_ollama

# The internal URL of the Ollama instance (Docker compose uses http://ollama:11434)
OLLAMA_HOST=http://ollama:11434

# Phase 4 Production Models (Frozen)
MINEINTEL_LOCAL_MODEL=qwen2.5:7b
MINEINTEL_LOCAL_VL_MODEL=qwen2.5vl:7b
LOCAL_AI_TIMEOUT=60
