# MineIntel Production Environment Variables
# -------------------------------------------
# Copy this file to .env for local development.
# For Vercel production deployment, set each variable in the Vercel dashboard under
# Project -> Settings -> Environment Variables.
#
# NEVER commit .env to git (it is already in .gitignore)

# --- REQUIRED: Master Authentication ---
# Master officer ID used to log in and to authorize creating new users.
MINEINTEL_OFFICER_ID=MOC-TEST-OFFICER-7890

# Master password for the officer above.
MINEINTEL_AUTH_PASSWORD=Enclave@Auth#2026

# --- REQUIRED: JWT Signing Secret ---
# Long random string used to sign/verify session tokens.
# Generate: python -c import secrets; print(secrets.token_hex(32))
MINEINTEL_JWT_SECRET=your-long-random-jwt-secret

# --- OPTIONAL: PostgreSQL (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- OPTIONAL: OpenRouter AI ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free
CLOUD_AI_TIMEOUT=30
