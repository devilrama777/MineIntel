# MineIntel Environment Variables Template (.env.example)
# -------------------------------------------------------------
# Copy this file to .env for local development:
#   cp .env.example .env
#
# STRICT SECURITY WARNING:
# NEVER commit the actual .env file or real secrets to git.

# --- Master Officer Authentication ---
# Employee ID / Officer username for master access
MINEINTEL_OFFICER_ID=your_master_officer_id_here

# Master authentication password
MINEINTEL_AUTH_PASSWORD=your_master_password_here

# --- Cryptographic Session Security ---
# Long random string for HMAC SHA256 session token signatures
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MINEINTEL_JWT_SECRET=your_jwt_signing_secret_here

# --- Database (REQUIRED for agent + auth persistence) ---
# Recommended: Neon free tier (https://neon.tech) — one URL works for 
# both local dev and production.
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# --- OCR Configuration ---
# Tesseract binary must be installed separately (system-level).
# Windows: https://github.com/UB-Mannheim/tesseract/wiki
# Linux:   sudo apt install tesseract-ocr
# Optional override:
TESSERACT_CMD=

# --- CORS & Network Configuration ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- AI Provider Configuration ---
# AI Provider: 'local_ollama' or 'openrouter'
MINEINTEL_AI_PROVIDER=local_ollama

# Ollama endpoint URL (default local: http://localhost:11434, Docker: http://ollama:11434)
OLLAMA_HOST=http://localhost:11434

# Phase 4 Local Models
MINEINTEL_LOCAL_MODEL=qwen2.5:7b
MINEINTEL_LOCAL_VL_MODEL=qwen2.5vl:7b
LOCAL_AI_TIMEOUT=120

# --- Groq Cloud (for web deployment) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Switch between local_ollama and groq
# MINEINTEL_AI_PROVIDER=local_ollama

