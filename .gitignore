# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Environments
.env
.env.*
.env*.local

# User storage & database files (dynamic runtime state)
backend/data/*.json
*.db
*.sqlite
*.sqlite3

# Temporary and log files
*.log
*.tmp
*.bak
temp/

# User uploads & processed caches
uploads/*
!uploads/.gitkeep
reported_data/*
!reported_data/.gitkeep
outputs/job_*
outputs/active_*
outputs/reports/*
!outputs/reports/.gitkeep
outputs/charts/*
!outputs/charts/.gitkeep
.freebuff/
scratch/
node_modules/
dist/
.vercel/
SIH_ps_2_test_1/
